!Copyright (C) 2023 Alexandre Rademaker
!See https://github.com/mhulden/foma/issues/130

read spaced-text tmp/nouns.stxt
define nouns ;
clear stack 

read spaced-text tmp/verbs.stxt
define verbs ;
clear stack 

read spaced-text tmp/clitics.stxt
define clitics ;
clear stack 

read spaced-text tmp/adjectives.stxt
define adjs ;
clear stack 

read spaced-text tmp/adverbs.stxt
define advs ;
clear stack

! Verbos gerados por regras (rules/ + lexicon/, ver #143). O lexc tem a
! análise no lado superior; .i inverte para a forma ficar no lado
! superior, como nos arquivos full-form.
read lexc tmp/verbs.lexc
define verbLex ;
clear stack
source rules/orthography.foma
define verbRules [verbLex .o. Orthography].i ;

! Diminutivos gerados por regras (rules/dim/ + lexicon/dim/, ver #149),
! produzidos por tools/dim.py generate no formato dos arquivos .dict.
read spaced-text tmp/dim.stxt
define dims ;
clear stack

regex  nouns | dims | verbs | verbRules | clitics | adjs | advs;
save stack morphobr.bin

